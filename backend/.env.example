# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agency_dashboard?schema=public"

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
REFRESH_COOKIE_NAME=adb_refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Optional when frontend and backend share a parent domain.
# COOKIE_DOMAIN=.example.com
